NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/patafeito
# Com um PostgreSQL local já ocupando a 5432, publique o container em outra porta:
# POSTGRES_PORT=5433
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/patafeito
# DOCS_ENABLED=true   # Swagger UI em /docs; padrão: ligado fora de produção
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
SYNC_RATE_LIMIT_MAX=30
# Gere um segredo de ao menos 32 caracteres para habilitar GET /metrics.
# METRICS_TOKEN=

# Produção (docker-compose.prod.yml), ver deploy/DEPLOY.md:
# NODE_ENV=production
# POSTGRES_USER=patafeito
# POSTGRES_PASSWORD=          # openssl rand -hex 32 (hex não quebra a DATABASE_URL)
# POSTGRES_DB=patafeito
# DATABASE_URL=postgres://patafeito:<POSTGRES_PASSWORD>@postgres:5432/patafeito   # host "postgres" = serviço do compose
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: openssl rand -hex 32, um para cada
# CORS_ORIGIN=https://api.seudominio.com.br
# TRUST_PROXY=1               # atrás do nginx, para o rate limit usar o IP real do cliente
