NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/patafeito
# Com um PostgreSQL local já ocupando a 5432, publique o container em outra porta:
# POSTGRES_PORT=5433
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/patafeito
# DOCS_ENABLED=true   # Swagger UI em /docs; padrão: ligado fora de produção
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
SYNC_RATE_LIMIT_MAX=30
# Gere um segredo de ao menos 32 caracteres para habilitar GET /metrics.
# METRICS_TOKEN=
